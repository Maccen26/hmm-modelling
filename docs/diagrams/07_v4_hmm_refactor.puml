@startuml 07_v4_hmm_refactor
' Proposed v4 structure: HMMParams is built from a transition and an emission
' (abstract base classes with concrete implementations underneath). The data,
' including the initial state distribution, lives in a Pydantic dataclass that
' the solver hands to the loss function together with HMMParams.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam ArrowColor #4A75B0
skinparam class {
    BackgroundColor #EAF1FB
    BorderColor #4A75B0
}
hide empty members

class HMMParams {
    + transition : BaseTransition
    + emission : BaseEmission
}

class Data <<pydantic dataclass>> {
    + ys : Array
    + ts : Array | None
    + xs : Array | None
    {field} + initial_distribution : Array (1, K)
}
note right of Data
  Fields are validated on construction
  (shapes, u sums to 1).
end note

abstract class BaseTransition {
    + transition_matrix(t, ys, xs, dt) : Array
}

abstract class BaseEmission {
    + density(t, ys, xs, ts) : Array
    + cdf(t, ys, xs, ts) : Array
    + mu(t, ys, xs, ts) : Array
}

class StaticTransition
class DynamicTransition
class ContinuousStaticTransition
class ContinuousDynamicTransition

class GaussEmission
class AutoregressiveGaussEmission

HMMParams *-- BaseTransition
HMMParams *-- BaseEmission

BaseTransition <|-- StaticTransition
BaseTransition <|-- DynamicTransition
BaseTransition <|-- ContinuousStaticTransition
BaseTransition <|-- ContinuousDynamicTransition

BaseEmission <|-- GaussEmission
BaseEmission <|-- AutoregressiveGaussEmission

' --- Fitting: a solver minimises a loss over HMMParams ---
abstract class BaseSolver {
    + fit(params : HMMParams, loss_fn : LossFunction, data : Data) : HMMParams
}

interface LossFunction <<Callable>> {
    (params : HMMParams, data : Data) -> float
}

class LBFGSSolver
class GradientSolver
class "negative_log_likelihood(params, data) -> float" as negative_log_likelihood <<function>>
note bottom of negative_log_likelihood
  return -ForwardAlgorithm().run(params, data).log_likelihood()
end note

' --- Inference: runs the HMM recursions over the data ---
abstract class BaseInference {
    + run(params : HMMParams, data : Data) : BaseOutput
}

class ForwardAlgorithm {
    + run(params : HMMParams, data : Data) : ForwardOutput
}

BaseInference <|-- ForwardAlgorithm
negative_log_likelihood ..> ForwardAlgorithm : calls

BaseSolver <|-- LBFGSSolver
BaseSolver <|-- GradientSolver
LossFunction <|.. negative_log_likelihood

BaseSolver --> LossFunction : uses
BaseSolver --> HMMParams : optimises
LossFunction ..> HMMParams : evaluates
LossFunction ..> Data : reads

' --- Diagnostics and prediction on a fitted model ---
class Diagnostics {
    + params : HMMParams
    + data : Data
    --
    + log_likelihood() : float
    + state_results() : StateResults
    + pseudo_residuals() : Array
}

abstract class BasePrediction {
    + predict(params : HMMParams, data : Data, t_pred : Array, x_pred : Array | None) : Array
}

class EmissionMeanPrediction

BasePrediction <|-- EmissionMeanPrediction

Diagnostics o-- HMMParams
Diagnostics o-- Data
BasePrediction ..> HMMParams : uses
BasePrediction ..> Data : uses
BaseSolver ..> Data : passes on

@enduml
