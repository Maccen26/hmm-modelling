\@writefile{lot}{\contentsline {table}{\numberline {5.1}{\ignorespaces Model comparison for $K = 3, \dots  , 6$ states. $\ell $ is the log-likelihood on the training set ($n = 3137$; for the covariate models without the ridge penalty), AIC $= 2p - 2\ell $ and BIC $= p\ln n - 2\ell $. RMSE (ppm) and MAPE are for the 6-steps-ahead forecasts on the validation set. LRT gives $2(\ell _{\mathrm  {full}} - \ell _{\mathrm  {reduced}})$ with its $\chi ^2$ $p$-value: HMM($\beta $) and AR(1)-HMM against the HMM ($2K(K-1)$ and $K$ degrees of freedom), and the AR(1)-Covariates HMM against the AR(1)-HMM / HMM($\beta $) ($2K(K-1)$ / $K$ degrees of freedom).}}{20}{table.caption.11}\protected@file@percent }
