\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Estimated transition probabilities for the AR(1) second-order HMM. Each row is a state pair $(s_{t-1}, s_t)$; columns give the next-state probability $P(s_{t+1} \mid s_{t-1}, s_t)$. A dash ($-$) indicates zero or negligible probability.}}{3}{table.caption.10}\protected@file@percent }
\newlabel{tab:second_order_hmm_transition}{{10}{3}{Estimated transition probabilities for the AR(1) second-order HMM. Each row is a state pair $(s_{t-1}, s_t)$; columns give the next-state probability $P(s_{t+1} \mid s_{t-1}, s_t)$. A dash ($-$) indicates zero or negligible probability}{table.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Estimated transition matrix for the AR(2)-HMM.}}{4}{table.caption.8}\protected@file@percent }
\newlabel{tab:ar_2_hmm_transition}{{8}{4}{Estimated transition matrix for the AR(2)-HMM}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Estimated emission parameters for the AR(2) second-order HMM. $\hat  {\sigma }$ and the AR(2) coefficients $\hat  {\phi }_1$, $\hat  {\phi }_2$ depend on $(s_{t-1}, s_t)$. A sum $\hat  {\phi }_1 + \hat  {\phi }_2 > 1$ indicates a non-stationary AR process for that state pair.}}{4}{table.caption.11}\protected@file@percent }
\newlabel{tab:ar_2_second_order_hmm_emissions}{{11}{4}{Estimated emission parameters for the AR(2) second-order HMM. $\hat {\sigma }$ and the AR(2) coefficients $\hat {\phi }_1$, $\hat {\phi }_2$ depend on $(s_{t-1}, s_t)$. A sum $\hat {\phi }_1 + \hat {\phi }_2 > 1$ indicates a non-stationary AR process for that state pair}{table.caption.11}{}}
